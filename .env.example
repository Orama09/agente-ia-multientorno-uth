# Copia este archivo a .env.local para desarrollo local sin Docker.
# En Docker, docker-compose.yml inyecta valores equivalentes automaticamente.

# --- ChromaDB (RAG) ---
CHROMA_URL=http://localhost:8000
# Umbral de distancia Chroma (L2, vectores normalizados de Gemini: 0-2). Más bajo = más estricto.
RAG_MAX_DISTANCE=0.8
# Solo se aceptan chunks cercanos al mejor resultado.
RAG_DISTANCE_MARGIN=0.15
# Colección vectorial en ChromaDB
CHROMA_COLLECTION_NAME=school_documents

# --- Gemini (Google AI) ---
GOOGLE_API_KEY=
GEMINI_API_KEY=

# --- Logs de rendimiento (chat/RAG) ---
# Solo consola del servidor. true|false fuerza on/off.
# Si se omite: on en development, off en production.
# ENABLE_PERFORMANCE_LOGS=true

# --- Experiencia del asistente (avatar + voz) ---
# Proveedor de avatar. Implementado: threejs (requiere public/models/avatar/)
# Futuros (no implementados): rive | live2d | liveavatar
NEXT_PUBLIC_AVATAR_PROVIDER=threejs

# Proveedor TTS. Implementados: none | web-speech
# Futuro (no implementado): external
NEXT_PUBLIC_TTS_PROVIDER=web-speech

# Si la voz inicia activada (solo aplica con web-speech)
NEXT_PUBLIC_VOICE_ENABLED_BY_DEFAULT=false

# --- Postgres (contenedor uth-postgres, ver docker-compose.yml) ---
POSTGRES_USER=uth_admin
POSTGRES_PASSWORD=
POSTGRES_DB=uth_tramites
# En Docker, docker-compose arma DATABASE_URL automáticamente con los 3 valores
# de arriba. Si corres "npm run dev" SIN Docker, agrega esta variable a mano
# apuntando a tu Postgres local, ej:
# DATABASE_URL=postgresql://uth_admin:tu_password@localhost:5432/uth_tramites

# --- Módulo de trámites ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_TO_EMAIL=

ADMIN_KEY=
APP_BASE_URL=http://localhost:3001